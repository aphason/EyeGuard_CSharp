<Window x:Class="EyeGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="爱眼卫士" Width="86" Height="40"
        WindowStyle="None" Background="#0d1117"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">
    <Border BorderBrush="#30363d" BorderThickness="1" CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Progress bar background track -->
            <Border Grid.Row="0" Background="#21262d" CornerRadius="0">
                <Rectangle x:Name="ProgressBar" Fill="#58a6ff"
                           HorizontalAlignment="Left" Width="136" Height="3"/>
            </Border>

            <!-- Countdown text centered -->
            <TextBlock Grid.Row="1" x:Name="CountdownText" Text="50:00"
                       FontFamily="Segoe UI" FontSize="24" FontWeight="300"
                       Foreground="#c9d1d9"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
